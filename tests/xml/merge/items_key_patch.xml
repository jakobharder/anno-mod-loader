<ModOps>
  <ModOp GUID="100780" Merge="Cost/Costs">
    <Costs>
      <!-- items without key are allowed at the beginning-->
      <Item>
        <Amount>11</Amount>
      </Item>
      <!-- exists out of order, merge values -->
      <ModItem Merge="Ingredient">
        <Ingredient>1010218</Ingredient>
        <Amount>14</Amount>
      </ModItem>
      <!-- ignore items without key afterwards -->
      <!--<Item>
        <Ingredient>567</Ingredient>
        <Amount>16</Amount>
      </Item>-->
      <!-- exists out of order, merge values -->
      <ModItem Merge="Ingredient">
        <Ingredient>1010196</Ingredient>
        <Amount>12</Amount>
      </ModItem>
      <!-- doesn't exist, add item -->
      <ModItem Merge="Ingredient">
        <Ingredient>123</Ingredient>
        <Amount>15</Amount>
      </ModItem>
      <!-- change the Ingredient -->
      <ModItem Merge="Ingredient='1010220'">
        <Ingredient>567</Ingredient>
        <Amount>17</Amount>
      </ModItem>
      <!-- custom append -->
      <ModItem Merge="Ingredient" Append="Ingredient='1010196'">
        <Ingredient>9</Ingredient>
        <Amount>18</Amount>
      </ModItem>
      <!-- custom prepend -->
      <ModItem Merge="Ingredient" Prepend="Ingredient='1010196'">
        <Ingredient>10</Ingredient>
        <Amount>19</Amount>
      </ModItem>
    </Costs>
  </ModOp>
</ModOps>