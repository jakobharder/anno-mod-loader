<ModOps>
  <ModOp Add="@1">
    <Building>
      <Range><ModValue Insert='$rangeA' /></Range>
    </Building>
  </ModOp>
  <ModOp Merge="@2">
    <Building>
      <Range><ModValue Insert='$other-mod.rangeB' /></Range>
    </Building>
  </ModOp>

  <ModOp Merge="@2">
    <Amount><ModValue Insert='self::node() * $multiplier'/></Amount>
    <Amount2><ModValue Insert='self::node() * $multiplier2'/></Amount2>
  </ModOp>
</ModOps>
