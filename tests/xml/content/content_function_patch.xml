<ModOps>
  <!-- simple -->
  <ModOp Type="replace"
    Path="/AssetList/Groups/Group/Assets/Asset/Values/Target/Count"
    Content="count(/AssetList/Groups/Group/Assets/Asset/Values/Source/Building)">
    <Count>
      <ModOpContent />
    </Count>
  </ModOp>

  <!-- GUID -->
  <ModOp GUID="456"
    Replace="TargetWithGuid/Count"
    Content="count(/AssetList/Groups/Group/Assets/Asset/Values/Source/Building)">
    <Count>
      <ModOpContent />
    </Count>
  </ModOp>

  <!-- GUID, self-contained -->
  <ModOp GUID="9"
    Replace="Residence7/ResidentMax"
    Content="number(Residence7/ResidentMax) + 2">
    <ResidentMax>
      <ModOpContent />
    </ResidentMax>
  </ModOp>

  <!-- items -->
  <ModOp GUID="10" Merge="Cost/Item">
    <Amount><ModValue Insert="number(.) + 10" /></Amount>
    <Number><ModValue Insert="$content-function.number" /></Number>
  </ModOp>

  <!-- multiple -->
  <ModOp Property="Maintenance" Merge="Workforce">
    <Workforce><ModValue Insert="number(.) + 10" /></Workforce>
  </ModOp>

  <!-- division -->
  <ModOp Property="Storage" Merge="Amount">
    <Amount><ModValue Insert="(number(.) - number(.) mod 2) div 2" /></Amount>
  </ModOp>
</ModOps>